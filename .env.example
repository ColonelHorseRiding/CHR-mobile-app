# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Both values are public client credentials, safe to ship in the app.
# NEVER put the service_role key or any Google client secret here.
EXPO_PUBLIC_SUPABASE_URL=
# Either the legacy anon key or the newer publishable key (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. The club website, which hosts Tack Shop photographs stored as site paths such as /assests/tack/helmet.jpeg.
# Defaults to https://colonelhorseriding.com. Photographs uploaded in Admin > Tack Shop come from the Supabase project.
# EXPO_PUBLIC_SITE_URL=https://colonelhorseriding.com
