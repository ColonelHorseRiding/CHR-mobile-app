{
  "expo": {
    "name": "Colonel Horse Riding Club",
    "slug": "CHR-mobile-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/chr-app-icon.png",
    "scheme": "chrmobileapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F3EA",
    "ios": {
      "backgroundColor": "#F7F3EA"
    },
    "android": {
      "package": "com.colonelhorseridingclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F3A2E",
        "foregroundImage": "./assets/images/brand/chr-adaptive-foreground.png",
        "monochromeImage": "./assets/images/brand/chr-adaptive-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/chr-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1410",
          "image": "./assets/images/brand/chr-logo.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/brand/chr-logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/chr-notification-icon.png",
          "color": "#1F3A2E",
          "defaultChannel": "club-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06c783ed-2caf-4b10-b7fe-e385a144ebde"
      }
    }
  }
}
